# Public site URL used for canonical URLs, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.instaviewstories.com

# --- Story/profile retrieval --------------------------------------------
# When HIKERAPI_KEY is set, lookups go through HikerApiStoryProvider
# (src/lib/story/hikerapi-provider.ts) — a licensed data vendor that
# maintains its own authenticated Instagram session server-side, so it can
# return actual Story media. Get a key at https://hikerapi.com (free trial:
# 100 requests, no card).
HIKERAPI_KEY=

# Optional fallback keys (separate HikerAPI accounts). When a request with
# HIKERAPI_KEY fails for any reason — bad/expired key, rate limited, or a
# HikerAPI-side error — it's retried with HIKERAPI_Fallback_1_KEY, then
# _2_KEY, then _3_KEY, and so on; add HIKERAPI_Fallback_4_KEY etc. and it's
# picked up automatically, no code change needed. Leave unset to run with
# just the one key.
HIKERAPI_Fallback_1_KEY=
HIKERAPI_Fallback_2_KEY=
HIKERAPI_Fallback_3_KEY=

# Without HIKERAPI_KEY (or any HIKERAPI_Fallback_N_KEY), lookups fall back to PublicWebStoryProvider
# (src/lib/story/public-web-provider.ts), which fetches Instagram's public
# profile page directly — no credentials required, but Story media is
# never retrieved: Instagram doesn't expose it on any unauthenticated
# surface. Read docs/story-retrieval-limitations.md before deploying.

# --- Anti-bot fetch (optional, only used by PublicWebStoryProvider) -----
# Optional. Instagram's bot detection reliably blocks direct requests in
# production; when set, profile fetches route through Scrapfly's managed
# Web Scraping API (asp=true) instead, so the request gets past bot
# detection before reaching our own parser. Same public page, same no-login
# boundary — this only changes how the HTTP request itself is made. Falls
# back to a direct fetch when unset. Get a key at https://scrapfly.io
# (free tier: 1,000 credits/mo, no card).
SCRAPFLY_API_KEY=

# --- Redis (Vercel Marketplace: Upstash Redis) -------------------------
# Auto-populated by `vercel integration add upstash/upstash-kv` + `vercel
# env pull`. Without either pair below, the featured-profiles carousel
# just skips caching — see src/lib/redis.ts. Vercel's current Marketplace
# integration provisions KV_REST_API_URL/TOKEN, not
# UPSTASH_REDIS_REST_URL/TOKEN — the client reads either name.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Featured profiles carousel (homepage) -----------------------------
# How long (in hours) the homepage's featured-profiles carousel data is
# cached in Redis before the next real visit refreshes it via a live
# HikerAPI call. Higher = fewer HikerAPI credits spent, staler avatars.
# Defaults to 120 (5 days) if unset.
FEATURED_PROFILES_CACHE_TTL_HOURS=120
